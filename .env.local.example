# Google Search Console — paste verification code from https://search.google.com/search-console
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-code

# Android APK (Capacitor) — must be your deployed HTTPS URL before building for distribution
CAPACITOR_SERVER_URL=https://www.picklebuzz.in

# DUPR API (Phase 9 — optional rating sync)
DUPR_API_KEY=your-dupr-api-key
DUPR_API_BASE_URL=https://api.dupr.gg

# Razorpay (Phase 8 — tournament fees)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Rate limiting (Upstash Redis — free tier works; required for production API protection)
# Create at https://console.upstash.com/redis then paste REST URL + token
UPSTASH_REDIS_REST_URL=your-upstash-redis-url
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-token
