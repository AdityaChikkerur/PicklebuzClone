NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
NEXT_PUBLIC_APP_NAME=PickleBuzz
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Android APK (Capacitor) — must be your deployed HTTPS URL before building for Play Store
CAPACITOR_SERVER_URL=https://your-app.vercel.app

# DUPR API (Phase 9 — optional rating sync)
DUPR_API_KEY=your-dupr-api-key
DUPR_API_BASE_URL=https://api.dupr.gg

# Razorpay (Phase 8 — tournament fees)
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
