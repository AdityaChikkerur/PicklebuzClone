<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Allow HTTP for LAN dev server (CAPACITOR_SERVER_URL=http://192.168.x.x:3000) -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
